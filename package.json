{
  "name": "xghost",
  "description": "Extension Chrome qui détecte les comptes X qui ont arrêté de te suivre.",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "postinstall": "wxt prepare",
    "release": "./release.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "i18next": "^26.7.1",
    "lucide": "^1.67.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/app-buildr/xghost.git"
  },
  "homepage": "https://app-buildr.github.io/xghost/"
}

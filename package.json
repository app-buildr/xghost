{
  "name": "xghost",
  "description": "Extension Chrome qui détecte les comptes X qui ont arrêté de te suivre.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "package": "npm run build && rm -rf pack xghost.zip && mkdir pack && cp -R dist pack/xGhost && (cd pack && zip -qrX ../xghost.zip xGhost) && rm -rf pack"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/app-buildr/xghost.git"
  },
  "homepage": "https://app-buildr.github.io/xghost/"
}

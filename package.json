    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "repository": {
    "type": "git",
